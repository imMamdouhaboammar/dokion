          "connected_tools_limit": 1
        },
        "guardrails": [
          "The underlying linter must pass independently.",
          "Start advisory and non-blocking.",
          "Report only relevant changed-line findings.",
          "Do not dump old backlog into each PR."
        ],
        "default_enabled": false,
        "requires_user_approval": true
      },
      {
        "id": "markdownlint",
        "name": "Markdownlint",
        "type": "documentation-linter",
        "role": "Check Markdown structure and formatting.",
        "applicability": "markdown_files_present",
        "documented_commands": [
          "npx markdownlint-cli2 \"**/*.md\""
        ],
        "guardrails": [
          "Document ignored rules.",
          "Avoid unsafe bulk formatting without diff review."
        ],
        "default_enabled": false,
        "requires_user_approval": true
      },
      {
        "id": "github-actions",
        "name": "GitHub Actions",
        "type": "ci-cd-engine",
        "role": "Run build, tests, linters, review bridges, and release checks in clean runners.",
        "applicability": "github_repository",
        "official_url": "https://github.com/features/actions",
        "command_resolution": "Use detected project-native scripts. Prefer Bun commands for Dokion-owned workflows.",
        "guardrails": [
          "Use minimum permissions.",
          "Keep third-party credentials in GitHub Secrets.",
          "Do not add deployment until build and test gates are stable.",
          "Pin third-party actions where policy requires it."
        ],
        "default_enabled": false,
        "requires_user_approval": true
      }
    ],
    "plugins_and_adapters": [
      {
        "id": "superpowers-plugin",
        "capability_ref": "superpowers",
        "platforms": [
          "codex",
          "claude-code",
          "gemini-cli"
        ],
        "role": "Process governance and development methodology.",
        "default_enabled": false
      },
      {
        "id": "open-code-review-plugin",
        "capability_ref": "open-code-review",
        "platforms": [
          "codex",
          "claude-code",
          "cursor"
        ],
        "documented_claude_install": [
          "/plugin marketplace add alibaba/open-code-review",
          "/plugin install open-code-review@open-code-review"
        ],
        "documented_claude_command": "/open-code-review:review",
        "default_enabled": false
      },
      {
        "id": "serena-mcp",
        "capability_ref": "serena",
        "platforms": [
          "codex",
          "claude-code",
          "gemini-cli",
          "cursor",
          "opencode"
        ],
        "default_enabled": false
      },
      {
        "id": "code-review-graph-mcp",
        "capability_ref": "code-review-graph",
        "platforms": [
          "codex",
          "claude-code",
          "gemini-cli",
          "cursor",
          "copilot"
        ],
        "default_enabled": false
      },
      {
        "id": "chrome-devtools-mcp",
        "capability_ref": "chrome-devtools-mcp",
        "platforms": [
          "mcp-compatible-agents"
        ],
        "default_enabled": false
      },
      {
        "id": "delegate-team-runtime",
        "capability_ref": "delegate-team",
        "platforms": [
          "lead-agent-with-local-shell"
        ],
        "default_enabled": false
      }
    ]
  },
  "loops": {
    "execution_policy": {
      "order_is_user_defined": true,
      "orchestrator_may_reorder": false,
      "undeclared_step_execution": false,
      "default_execution": "SEQUENTIAL",
      "parallel_read_only_requires_declaration": true,
      "parallel_writes_require_isolated_worktrees": true,
      "one_writer_by_default": true
    },
    "definitions": [
      {
        "id": "bootstrap-and-inventory",
        "name": "Bootstrap and Inventory Loop",
        "purpose": "Establish repository truth, stack, scripts, Git state, and applicable surfaces.",
        "maximum_iterations": 1,
        "ordered_steps": [
          {
            "id": "git-baseline",
            "executor": "dokion-core",
            "mode": "READ_ONLY",
            "actions": [
              "Record repository root, branch, commit SHA, remotes, and working-tree status.",
              "Preserve unrelated user changes.",
              "Detect project scripts and existing quality gates."
            ]
          },
          {
            "id": "project-graph",
            "executor": "graphify",
            "condition": "user_enabled(graphify) AND graph_tooling_is_justified",
            "mode": "READ_ONLY",
            "run": [
              "/graphify ."
            ],
            "success_evidence": [
              "graphify-out/GRAPH_REPORT.md",
              "graphify-out/graph.json"
            ]
          },
          {
            "id": "semantic-activation",
            "executor": "serena",
            "condition": "user_enabled(serena)",
            "mode": "READ_ONLY",
            "actions": [
              "Activate current project.",
              "Read Serena initial instructions.",
              "Identify relevant symbols and entry points."
            ]
          },
          {
            "id": "inventory-report",
            "executor": "dokion-core",
            "mode": "REPORT_ONLY",
            "outputs": [
              ".dokion/state.json",
              "HARDENING.md"
            ]
          }
        ]
      },
      {
        "id": "disciplined-change",
        "name": "Disciplined Change Loop",
        "purpose": "Plan and implement bounded fixes with tests and semantic edits.",
        "maximum_iterations": 5,
        "ordered_steps": [
          {
            "id": "design-and-plan",
            "executor": "superpowers",
            "condition": "user_enabled(superpowers)",
            "mode": "ANALYZE",
            "skills": [
              "brainstorming",
              "writing-plans"
            ]
          },
          {
            "id": "failing-test",
            "executor": "superpowers",
            "mode": "FIX_WITH_APPROVAL",
            "skills": [
              "test-driven-development"
            ],
            "success_condition": "A failing regression test or an explicit documented reason why automated reproduction is not possible."
          },
          {
            "id": "bounded-implementation",
            "executor": "lead-agent",
            "helpers": [
              "serena",
              "rtk"
            ],
            "optional_delegate": "delegate-team",
            "mode": "FIX_WITH_APPROVAL",
            "rules": [
              "Use the smallest repair batch.",
              "Touch only declared paths.",
              "Do not allow delegated agents to commit.",
              "Run targeted verification after each batch."
            ]
          },
          {
            "id": "targeted-verification",
            "executor": "project-native",
            "mode": "VERIFY_ONLY",
            "command_resolution": [
              "Detect and run the most specific relevant test.",
              "Run type checking or compilation when applicable.",
              "Preserve exact failures."
            ]
          }
        ]
      },
      {
        "id": "ui-ux-hardening",
        "name": "UI and UX Hardening Loop",
        "purpose": "Audit and repair real frontend behavior, visuals, accessibility, and edge cases.",
        "maximum_iterations": 3,
        "applicability": "ui_detected",
        "ordered_steps": [
          {
            "id": "ui-context",
            "executor": "impeccable",
            "mode": "ANALYZE",
            "run_preference": [
              "/impeccable init",
              "/impeccable document"
            ],
            "selection_rule": "Use init for first setup; use document for an existing UI without design context."
          },
          {
            "id": "ui-audit",
            "executor": "impeccable",
            "mode": "ANALYZE",
            "run": [
              "/impeccable critique",
              "/impeccable audit",
              "npx impeccable detect --json ."
            ]
          },
          {
            "id": "browser-verification-baseline",
            "executor": "chrome-devtools-mcp",
            "condition": "user_enabled(chrome-devtools-mcp)",
            "mode": "VERIFY_ONLY",
            "checks": [
              "Primary user flow",
              "Console errors and warnings",
              "Failed API requests",
              "Responsive layout",
              "Loading, empty, error, and long-content states"
            ]
          },
          {
            "id": "ui-fix-batch",
            "executor": "impeccable",
            "mode": "FIX_WITH_APPROVAL",
            "command_selection": [
              "/impeccable layout",
              "/impeccable typeset",
              "/impeccable clarify",
              "/impeccable harden",
              "/impeccable adapt",
              "/impeccable polish"
            ],
            "selection_rule": "Run only commands matching validated findings."
          },
          {
            "id": "react-quality-gate",
            "executor": "react-doctor",
            "condition": "react_detected AND user_enabled(react-doctor)",
            "mode": "ANALYZE",
            "run": [
              "npx react-doctor@latest --no-telemetry"
            ]
          },
          {
            "id": "ui-regression-verification",
            "executor": "project-native-and-browser",
            "mode": "VERIFY_ONLY",
            "checks": [
              "Re-run affected UI tests.",
              "Re-run Impeccable detector.",
              "Re-run React Doctor when applicable.",
              "Repeat browser flow and compare evidence."
            ]
          }
        ]
      },
      {
        "id": "debugging",
        "name": "Systematic Debugging Loop",
        "purpose": "Reproduce, isolate, repair, and verify defects without regressions.",
        "maximum_iterations": 3,
        "ordered_steps": [
          {
            "id": "reproduce",
            "executor": "lead-agent",
            "helpers": [
              "chrome-devtools-mcp",
              "rtk"
            ],
            "mode": "ANALYZE",
            "success_condition": "A failing automated test or stable manual reproduction."
          },
          {
            "id": "root-cause",
            "executor": "superpowers",
            "helpers": [
              "serena",
              "code-review-graph"
            ],
            "skills": [
              "systematic-debugging"
            ],
            "mode": "ANALYZE"
          },
          {
            "id": "smallest-fix",
            "executor": "lead-agent",
            "helpers": [
              "serena"
            ],
            "mode": "FIX_WITH_APPROVAL"
          },
          {
            "id": "reproduction-verification",
            "executor": "project-native",
            "mode": "VERIFY_ONLY"
          },
          {
            "id": "regression-suite",
            "executor": "project-native",
            "mode": "VERIFY_ONLY"
          },
          {
            "id": "post-fix-review",
            "executor": "open-code-review",
            "condition": "user_enabled(open-code-review)",
            "mode": "ANALYZE",
            "run": [
              "ocr review --preview",
              "ocr review"
            ]
          }
        ]
      },
      {
        "id": "review-and-repair",
        "name": "Review and Repair Loop",
        "purpose": "Combine blast-radius analysis, deterministic checks, and AI diff review.",
        "maximum_iterations": 3,
        "ordered_steps": [
          {
            "id": "refresh-review-graph",
            "executor": "code-review-graph",
            "condition": "user_enabled(code-review-graph)",
            "mode": "READ_ONLY",
            "run": [
              "code-review-graph update --brief"
            ]
          },
          {
            "id": "blast-radius-review",
            "executor": "code-review-graph",
            "condition": "user_enabled(code-review-graph)",
            "mode": "ANALYZE",
            "run": [
              "code-review-graph detect-changes --brief --verify"
            ],
            "required_outputs": [
              "Changed symbols",
              "Affected callers and dependents",
              "Affected flows",
              "Test gaps",
              "Risk score",
              "Human-review paths"
            ]
          },
          {
            "id": "diff-preview",
            "executor": "open-code-review",
            "condition": "user_enabled(open-code-review)",
            "mode": "READ_ONLY",
            "run": [
              "ocr review --preview"
            ]
          },
          {
            "id": "ai-diff-review",
            "executor": "open-code-review",
            "condition": "user_enabled(open-code-review)",
            "mode": "ANALYZE",
            "run": [
              "ocr review --format json --audience agent"
            ]
          },
          {
            "id": "classify-findings",
            "executor": "dokion-core",
            "mode": "ANALYZE",
            "groups": [
              "MUST_FIX",
              "SHOULD_FIX",
              "OPTIONAL",
              "FALSE_POSITIVE",
              "NEEDS_HUMAN_REVIEW"
            ]
          },
          {
            "id": "fix-high-confidence",
            "executor": "lead-agent",
            "helpers": [
              "serena",
              "superpowers"
            ],
            "mode": "FIX_WITH_APPROVAL",
            "scope": "MUST_FIX findings with validated evidence"
          },
          {
            "id": "rerun-review",
            "executor": "open-code-review-and-code-review-graph",
            "mode": "VERIFY_ONLY",
            "success_condition": "No unresolved blocking finding introduced by the current diff."
          }
        ]
      },
      {
        "id": "ci-feedback",
        "name": "CI Feedback Loop",
        "purpose": "Expose existing deterministic findings directly on pull requests.",
        "maximum_iterations": 2,
        "applicability": "github_repository AND working_linter_exists",
        "ordered_steps": [
          {
            "id": "select-one-check",
            "executor": "user",
            "mode": "CONFIGURE",
            "rules": [
              "Select one existing high-signal linter or analyzer.",
              "Do not add multiple reviewdog checks initially."
            ]
          },
          {
            "id": "configure-reviewdog",
            "executor": "reviewdog",
            "mode": "FIX_WITH_APPROVAL",
            "defaults": {
              "reporter": "github-pr-review",
              "filter_mode": "added",
              "level": "warning",
              "blocking": false
            }
          },
          {
            "id": "small-pr-validation",
            "executor": "github-actions",
            "mode": "VERIFY_ONLY",
            "success_condition": "Comments are relevant, limited to changed lines, and not noisy."
          },
          {
            "id": "tune-policy",
            "executor": "user",
            "mode": "CONFIGURE",
            "options": [
              "Keep advisory",
              "Change reporter",
              "Change filter mode",
              "Add another check",
              "Promote a trusted check to blocking"
            ]
          }
        ]
      },
      {
        "id": "shipping",
        "name": "Shipping Readiness Loop",
        "purpose": "Verify a release candidate and generate an evidence-based readiness decision.",
        "maximum_iterations": 2,
        "ordered_steps": [
          {
            "id": "workspace-check",
            "executor": "dokion-core",
            "mode": "READ_ONLY",
            "checks": [
              "Correct branch and commit",
              "Known working-tree state",
              "No accidental generated artifacts",
              "No unresolved merge conflicts"
            ]
          },
          {
            "id": "build-and-test",
            "executor": "project-native",
            "helpers": [
              "rtk"
            ],
            "mode": "VERIFY_ONLY",
            "command_resolution": [
              "bun run typecheck when available",
              "bun run lint when available",
              "bun test when available",
              "bun run build when available",
              "otherwise use the repository's verified native commands"
            ]
          },
          {
            "id": "frontend-gates",
            "executor": "conditional-ui-stack",
            "condition": "ui_detected",
            "mode": "VERIFY_ONLY",
            "capabilities": [
              "impeccable",
              "react-doctor",
              "chrome-devtools-mcp"
            ]
          },
          {
            "id": "review-gates",
            "executor": "conditional-review-stack",
            "mode": "VERIFY_ONLY",
            "capabilities": [
              "code-review-graph",
              "open-code-review"
            ]
          },
          {
            "id": "ci-status",
            "executor": "github-actions",
            "condition": "github_actions_configured",
            "mode": "VERIFY_ONLY"
          },
          {
            "id": "live-smoke-test",
            "executor": "chrome-devtools-mcp",
            "condition": "browser_application AND test_environment_available",
            "mode": "VERIFY_ONLY"
          },
          {
            "id": "readiness-report",
            "executor": "dokion-core",
            "mode": "REPORT_ONLY",
            "outputs": [
              "HARDENING.md",
              ".dokion/reports/readiness.json"
            ]
          }
        ]
      }
    ]
  },
  "finding_and_evidence_policy": {
    "finding_statuses": [
      "OPEN",
      "VALIDATING",
      "APPROVED_FOR_FIX",
      "FIXING",
      "FIXED_PENDING_VERIFICATION",
      "VERIFIED",
      "FALSE_POSITIVE",
      "ACCEPTED_RISK",
      "BLOCKED",
      "DEFERRED"
    ],
    "severities": [
      "CRITICAL",
      "HIGH",
      "MEDIUM",
      "LOW",
      "INFO"
    ],
    "required_evidence": [
      "source capability",
      "exact command or agent action",
      "timestamp",
      "Git commit SHA",
      "affected paths",
      "raw or redacted detector output",
      "repair diff when changed",
      "targeted verification",
      "regression verification"
    ],
    "repair_policy": {
      "fix_all_findings_blindly": false,
      "default_batch": "smallest_high-confidence_batch",
      "max_fix_attempts_per_finding": 3,
      "rollback_required": true
    }
  },
  "release_readiness": {
    "statuses": [
      "NOT_READY",
      "CONDITIONALLY_READY",
      "READY_FOR_STAGING",
      "READY_FOR_PRODUCTION"
    ],
    "critical_blocker_overrides_score": true,
    "default_blockers": [
      "Build failure",
      "Required test failure",
      "Unresolved merge conflict",
      "Validated critical finding",
      "Validated high finding marked blocking by the user",
      "Failed required user flow",
      "Missing required approval",
      "Capability executed outside approved scope",
      "Evidence tied to a different commit"
    ],
    "completion_statement_template": "This repository passed the user-configured Dokion gates at commit <sha>. Remaining limitations, manual checks, skipped steps, and accepted risks are recorded in HARDENING.md."
  },
  "coverage": {
    "covered_by_riftbook_selection": [
      "project mapping",
      "semantic code navigation",
      "structured planning",
      "test-driven changes",
      "systematic debugging",
      "UI and UX auditing",
      "React quality scanning",
      "browser flow verification",
      "blast-radius analysis",
      "AI diff review",
      "deterministic PR feedback",
      "documentation linting",
      "CI execution",
      "terminal output compression",
      "controlled agent delegation"
    ],
    "gaps_requiring_user_selected_capabilities": [
      {
        "lane": "application-security",
        "status": "UNASSIGNED",
        "reason": "Riftbook does not currently provide a dedicated general-purpose SAST and security-hardening capability in the reviewed catalog."
      },
      {
        "lane": "api-security-and-contracts",
        "status": "UNASSIGNED",
        "reason": "No dedicated OpenAPI, GraphQL, authorization, or API fuzzing capability was identified in the reviewed catalog."
      },
      {
        "lane": "database-hardening",
        "status": "UNASSIGNED",
        "reason": "No dedicated migration safety, RLS, schema integrity, or database security capability was identified."
      },
      {
        "lane": "performance-benchmarking",
        "status": "PARTIAL",
        "reason": "React Doctor and browser tooling can identify some frontend issues, but no dedicated benchmark or load-testing system was identified."
      },
      {
        "lane": "observability",
        "status": "UNASSIGNED",
        "reason": "No dedicated logging, tracing, metrics, or alert validation capability was identified."
      },
      {
        "lane": "supply-chain-and-release-security",
        "status": "UNASSIGNED",
        "reason": "No dedicated SBOM, provenance, dependency policy, secret scanning, or artifact signing capability was identified."
      },
      {
        "lane": "mobile-native-security",
        "status": "UNASSIGNED",
        "reason": "No dedicated Android or iOS security-testing capability was identified."
      }
    ]
  },
  "user_approval_checklist": {
    "required_before_first_run": [
      "Approve the selected capabilities.",
      "Approve the exact loop order.",
      "Approve install commands and installation scope.",
      "Approve read and write paths.",
      "Approve network access.",
      "Approve commands allowed to run.",
      "Choose which coverage gaps must block completion.",
      "Choose release gates.",
      "Choose whether Dokion may commit changes.",
      "Choose whether any fix category may run automatically."
    ],
    "recommended_initial_profile": {
      "status": "PROPOSED_ONLY",
      "capabilities": [
        "superpowers",
        "graphify",
        "serena",
        "rtk",
        "impeccable",
        "react-doctor",
        "chrome-devtools-mcp",
        "code-review-graph",
        "open-code-review",
        "reviewdog",
        "github-actions"
      ],
      "note": "This list is extracted and composed from Riftbook. It is not active until the user approves it."
    }
  }
}
