{
  "name": "dokion",
  "version": "0.3.0",
  "description": "User-directed cross-agent software hardening runtime",
  "type": "module",
  "private": false,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "bin": {
    "dokion": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/dokion",
    "validate:contracts": "python3 schemas/conformance_test.py && bun run src/cli.ts validate --catalog-only"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
