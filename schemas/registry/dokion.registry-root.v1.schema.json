{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dokion.dev/dokion.registry-root.v1.schema.json",
  "title": "Dokion Registry Root v1",
  "type": "object",
  "required": ["schema", "source", "generated_at", "expires_at", "indexes", "authority"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "dokion.registry-root.v1" },
    "source": {
      "type": "object",
      "required": ["id", "name", "transport", "location"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "https://schemas.dokion.dev/common.schema.json#/$defs/sourceId" },
        "name": { "$ref": "https://schemas.dokion.dev/common.schema.json#/$defs/sourceName" },
        "transport": { "type": "string", "enum": ["local", "https", "git"] },
        "location": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "immutable_revision": { "$ref": "https://schemas.dokion.dev/common.schema.json#/$defs/gitCommit" }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "git" } }, "required": ["transport"] },
          "then": {
            "required": ["immutable_revision"],
            "properties": {
              "location": { "$ref": "https://schemas.dokion.dev/common.schema.json#/$defs/safeHttpsUri" }
            }
          }
        },
        {
          "if": { "properties": { "transport": { "const": "https" } }, "required": ["transport"] },
          "then": {
            "properties": {
              "location": { "$ref": "https://schemas.dokion.dev/common.schema.json#/$defs/safeHttpsUri" }
            }
          }
        }
      ]
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "indexes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["location", "digest", "size"],
        "additionalProperties": false,
        "properties": {
          "location": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "digest": { "$ref": "https://schemas.dokion.dev/common.schema.json#/$defs/sha256Digest" },
          "size": { "$ref": "https://schemas.dokion.dev/common.schema.json#/$defs/positiveInteger" },
          "immutable_revision": { "$ref": "https://schemas.dokion.dev/common.schema.json#/$defs/gitCommit" }
        }
      }
    },
    "authority": { "$ref": "https://schemas.dokion.dev/common.schema.json#/$defs/authorityNone" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": { "transport": { "const": "https" } },
            "required": ["transport"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "indexes": {
            "items": {
              "properties": {
                "location": { "$ref": "https://schemas.dokion.dev/common.schema.json#/$defs/safeHttpsUri" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": { "transport": { "const": "git" } },
            "required": ["transport"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "indexes": {
            "items": {
              "required": ["immutable_revision"]
            }
          }
        }
      }
    }
  ]
}
