{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/imMamdouhaboammar/dokion/main/schemas/dokion-invocation-receipt.schema.json",
  "title": "Dokion Invocation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "invocation_id",
    "run_id",
    "stage_id",
    "step_id",
    "capability",
    "status",
    "command",
    "inputs",
    "outputs",
    "created_at",
    "ended_at"
  ],
  "properties": {
    "schema": {
      "const": "dokion.invocation-receipt.v1"
    },
    "invocation_id": {
      "$ref": "#/$defs/token"
    },
    "run_id": {
      "$ref": "#/$defs/token"
    },
    "stage_id": {
      "$ref": "#/$defs/token"
    },
    "step_id": {
      "$ref": "#/$defs/token"
    },
    "capability": {
      "$ref": "#/$defs/capability"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "command": {
      "$ref": "#/$defs/command"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "failure": {
      "$ref": "#/$defs/failure"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "failure"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "failure"
        ]
      }
    }
  ],
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "metadataString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "json",
        "text",
        "file",
        "binary",
        "sarif",
        "junit",
        "patch",
        "opaque"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "immutable_reference"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/metadataString"
        },
        "id": {
          "$ref": "#/$defs/metadataString"
        },
        "immutable_reference": {
          "$ref": "#/$defs/metadataString"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "blob_path",
        "descriptor_path"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "blob_path": {
          "type": "string",
          "pattern": "^\\.dokion/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/artifacts/sha256/[a-f0-9]{2}/[a-f0-9]{62}/blob$"
        },
        "descriptor_path": {
          "type": "string",
          "pattern": "^\\.dokion/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/artifacts/by-step/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "required",
        "producer",
        "artifact"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "required": {
          "type": "boolean"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "output"
          ],
          "properties": {
            "step": {
              "$ref": "#/$defs/token"
            },
            "output": {
              "$ref": "#/$defs/token"
            }
          }
        },
        "artifact": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "artifact"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "artifact": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "kind",
        "exit_code",
        "started_at",
        "ended_at",
        "duration_ms",
        "checkpoint_id",
        "checkpoint_status"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ARGV",
            "SHELL"
          ]
        },
        "exit_code": {
          "type": "integer"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_id": {
          "type": "string",
          "pattern": "^side-effect-[a-f0-9]{32}$"
        },
        "checkpoint_status": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/metadataString"
        },
        "message": {
          "$ref": "#/$defs/metadataString"
        }
      }
    }
  }
}
