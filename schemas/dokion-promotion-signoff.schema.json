{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dokion.dev/schemas/dokion-promotion-signoff.schema.json",
  "title": "DokionPromotionSignoffRecord",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "commit",
    "claimedSurfaces",
    "playbookDigest",
    "lockDigest",
    "promotionReady",
    "signoffDigest",
    "signedAt",
    "reviewer"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "version": { "type": "string" },
    "commit": { "type": "string" },
    "claimedSurfaces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "playbookDigest": { "type": "string" },
    "lockDigest": { "type": "string" },
    "promotionReady": { "type": "boolean" },
    "signoffDigest": { "type": "string" },
    "signedAt": { "type": "string" },
    "reviewer": { "type": "string" }
  },
  "additionalProperties": false
}
