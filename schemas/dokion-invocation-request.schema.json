{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/imMamdouhaboammar/dokion/main/schemas/dokion-invocation-request.schema.json",
  "title": "Dokion Invocation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "invocation_id",
    "run_id",
    "stage_id",
    "step_id",
    "capability",
    "command",
    "inputs",
    "legacy_inputs",
    "missing_optional_inputs",
    "expected_outputs",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "dokion.invocation-request.v1"
    },
    "invocation_id": {
      "$ref": "#/$defs/token"
    },
    "run_id": {
      "$ref": "#/$defs/token"
    },
    "stage_id": {
      "$ref": "#/$defs/token"
    },
    "step_id": {
      "$ref": "#/$defs/token"
    },
    "capability": {
      "$ref": "#/$defs/capability"
    },
    "command": {
      "$ref": "#/$defs/commandIdentity"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "legacy_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metadataString"
      }
    },
    "missing_optional_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expectedOutput"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "metadataString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "json",
        "text",
        "file",
        "binary",
        "sarif",
        "junit",
        "patch",
        "opaque"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "immutable_reference"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/metadataString"
        },
        "id": {
          "$ref": "#/$defs/metadataString"
        },
        "immutable_reference": {
          "$ref": "#/$defs/metadataString"
        }
      }
    },
    "commandIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "kind"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ARGV",
            "SHELL"
          ]
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "blob_path",
        "descriptor_path"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "blob_path": {
          "type": "string",
          "pattern": "^\\.dokion/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/artifacts/sha256/[a-f0-9]{2}/[a-f0-9]{62}/blob$"
        },
        "descriptor_path": {
          "type": "string",
          "pattern": "^\\.dokion/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/artifacts/by-step/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "required",
        "producer",
        "artifact"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "required": {
          "type": "boolean"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "output"
          ],
          "properties": {
            "step": {
              "$ref": "#/$defs/token"
            },
            "output": {
              "$ref": "#/$defs/token"
            }
          }
        },
        "artifact": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "path"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "media_type": {
          "$ref": "#/$defs/metadataString"
        },
        "declared_schema": {
          "$ref": "#/$defs/metadataString"
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "SECRET"
          ]
        },
        "retention": {
          "type": "string",
          "enum": [
            "RUN",
            "PROJECT",
            "RELEASE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^\\.dokion/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/invocations/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/outputs/output-[1-9][0-9]*\\.bin$"
        }
      }
    }
  }
}
